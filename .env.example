# Absolute path to the racket binary used by /api/run to execute
# student code. Falls back to "racket" (resolved from PATH) if unset.
RACKET_BIN=/usr/bin/racket

# Max number of Racket processes /api/run runs at the same time. Extra
# requests queue instead of running concurrently. Falls back to the number
# of CPU cores if unset.
RACKET_MAX_CONCURRENCY=1
